{"format":"thecms.extension/3","manifest":{"name":"stats","displayName":"Statistics","description":"Who reads the site, counted by its own server: no cookie and no script on the pages, so visitors are asked nothing. Robots and people signed in to the admin are not counted. Keeps each day's totals for a month and each month's for good.","version":"1.0.0","publisher":"thecms","thecmsMinVersion":"0.1.0","collections":[{"name":"days","label":"Days","fields":[{"key":"day","label":"Day","kind":"date"},{"key":"kind","label":"What","kind":"text"},{"key":"name","label":"Name","kind":"text"},{"key":"hits","label":"Times","kind":"number"}]},{"name":"months","label":"Months","fields":[{"key":"month","label":"Month","kind":"text"},{"key":"kind","label":"What","kind":"text"},{"key":"name","label":"Name","kind":"text"},{"key":"hits","label":"Times","kind":"number"}]}],"actions":[{"name":"served","label":"Count the pages seen","writes":["days","months"]},{"name":"searched","label":"Count the searches","writes":["days","months"]},{"name":"forget","label":"Forget the days older than a month","reads":["days"],"writes":["days"]},{"name":"report","label":"Statistics","reads":["days","months"]}],"events":[{"on":"page.served","action":"served"},{"on":"search.made","action":"searched"}],"jobs":[{"action":"forget","everyMinutes":1440}],"views":[{"spec":"thecms.view/1","id":"stats.report","title":"Statistics","type":"report","action":"report"}],"messages":{"ro":{"Days":"Zile","Months":"Luni","Day":"Zi","Month":"Lună","What":"Ce","Name":"Nume","Times":"De câte ori","Count the pages seen":"Numără paginile văzute","Count the searches":"Numără căutările","Forget the days older than a month":"Uită zilele mai vechi de o lună","Statistics":"Statistici","Visitors":"Vizitatori","Pages seen":"Pagini văzute","Pages read most":"Cele mai citite pagini","Where visitors came from":"De unde au venit vizitatorii","Devices":"Dispozitive","Searched for on the site":"Ce au căutat pe site","Directly (a typed address or a bookmark)":"Direct (adresă scrisă sau semn de carte)","Phone":"Telefon","Tablet":"Tabletă","Computer":"Calculator"}}},"code":"// @bun\n// extensions/stats/rows.ts\nvar NAME_MAX = 200;\nvar DAYS_KEPT = 31;\nfunction hashOf(name) {\n  let a = 2166136261;\n  let b = 16777619 ^ 1540483477;\n  for (let i = 0;i < name.length; i++) {\n    const c = name.charCodeAt(i);\n    a = Math.imul(a ^ c, 16777619) >>> 0;\n    b = Math.imul(b ^ c, 1540483477) >>> 0;\n    b ^= b >>> 15;\n  }\n  return a.toString(16).padStart(8, \"0\") + (b >>> 0).toString(16).padStart(8, \"0\");\n}\nfunction rowsOf(day, kind, name, hits) {\n  const kept = name.slice(0, NAME_MAX);\n  const month = day.slice(0, 7);\n  return [\n    { collection: \"days\", id: `${day}:${kind}:${hashOf(kept)}`, row: { day, kind, name: kept }, hits },\n    { collection: \"months\", id: `${month}:${kind}:${hashOf(kept)}`, row: { month, kind, name: kept }, hits }\n  ];\n}\nfunction summed(totals) {\n  const by = new Map;\n  for (const total of totals) {\n    for (const one of rowsOf(total.day, total.kind, total.name, total.hits)) {\n      const key = `${one.collection}\\x00${one.id}`;\n      const before = by.get(key);\n      if (before)\n        before.hits += one.hits;\n      else\n        by.set(key, one);\n    }\n  }\n  return [...by.values()];\n}\n\n// extensions/stats/index.ts\nvar TOP = 10;\nvar DAY = /^\\d{4}-\\d{2}-\\d{2}$/;\nasync function add(host, totals) {\n  for (const one of summed(totals))\n    await host.collections.add(one.collection, one.id, { hits: one.hits }, one.row);\n}\nfunction dayIn(zone, at) {\n  try {\n    return new Intl.DateTimeFormat(\"en-CA\", { timeZone: zone, year: \"numeric\", month: \"2-digit\", day: \"2-digit\" }).format(at);\n  } catch {\n    return new Date(at).toISOString().slice(0, 10);\n  }\n}\nfunction daysOf(range, last) {\n  const count = range === \"today\" ? 1 : Number(range);\n  const end = Date.parse(`${last}T12:00:00Z`);\n  return Array.from({ length: count }, (_, i) => new Date(end - (count - 1 - i) * 86400000).toISOString().slice(0, 10));\n}\nfunction monthsOf(last) {\n  const [year, month] = last.split(\"-\").map(Number);\n  return Array.from({ length: 12 }, (_, i) => {\n    const at = new Date(Date.UTC(year, month - 12 + i, 1));\n    return `${at.getUTCFullYear()}-${String(at.getUTCMonth() + 1).padStart(2, \"0\")}`;\n  });\n}\nvar DEVICES = { phone: \"Phone\", tablet: \"Tablet\", computer: \"Computer\" };\nvar actions = {\n  async served(input, host) {\n    const totals = [];\n    for (const item of input.items ?? []) {\n      if (!DAY.test(String(item.day)))\n        continue;\n      const day = item.day;\n      totals.push({ day, kind: \"views\", name: \"\", hits: 1 }, { day, kind: \"page\", name: String(item.path ?? \"\"), hits: 1 });\n      if (item.source || item.source === \"\" && item.first)\n        totals.push({ day, kind: \"source\", name: String(item.source), hits: 1 });\n      if (item.first)\n        totals.push({ day, kind: \"visitors\", name: \"\", hits: 1 }, { day, kind: \"device\", name: String(item.device ?? \"\"), hits: 1 });\n    }\n    await add(host, totals);\n  },\n  async searched(input, host) {\n    await add(host, (input.items ?? []).filter((item) => DAY.test(String(item.day)) && item.words).map((item) => ({ day: item.day, kind: \"search\", name: String(item.words), hits: 1 })));\n  },\n  async forget(input, host) {\n    const now = Date.parse(input.at ?? \"\") || Date.now();\n    const oldest = new Date(now - (DAYS_KEPT + 1) * 86400000).toISOString().slice(0, 10);\n    for (const row of await host.collections.list(\"days\"))\n      if (String(row.day) < oldest)\n        await host.collections.delete(\"days\", String(row.id));\n  },\n  async report(input, host) {\n    const range = [\"today\", \"7\", \"30\", \"365\"].find((r) => r === input.range) ?? \"30\";\n    const today = dayIn(String(input.timeZone ?? \"UTC\"), typeof input.now === \"number\" ? input.now : Date.now());\n    const byMonth = range === \"365\";\n    const slots = byMonth ? monthsOf(today) : daysOf(range, today);\n    const chart = new Map(slots.map((at) => [at, { visitors: 0, views: 0 }]));\n    const lists = { page: new Map, source: new Map, device: new Map, search: new Map };\n    let visitors = 0;\n    let views = 0;\n    for (const row of await host.collections.list(byMonth ? \"months\" : \"days\")) {\n      const slot = chart.get(String(byMonth ? row.month : row.day));\n      if (!slot)\n        continue;\n      const hits = Number(row.hits) || 0;\n      const name = String(row.name ?? \"\");\n      if (row.kind === \"visitors\") {\n        visitors += hits;\n        slot.visitors += hits;\n      } else if (row.kind === \"views\") {\n        views += hits;\n        slot.views += hits;\n      } else if (row.kind === \"page\" || row.kind === \"source\" || row.kind === \"device\" || row.kind === \"search\") {\n        lists[row.kind].set(name, (lists[row.kind].get(name) ?? 0) + hits);\n      }\n    }\n    const top = (list, label = (name) => name) => [...list].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, TOP).map(([name, value]) => ({ label: label(name), value }));\n    return {\n      totals: [\n        { label: \"Visitors\", value: visitors },\n        { label: \"Pages seen\", value: views }\n      ],\n      chart: range === \"today\" ? null : {\n        labels: slots,\n        series: [\n          { label: \"Visitors\", values: slots.map((at) => chart.get(at)?.visitors ?? 0) },\n          { label: \"Pages seen\", values: slots.map((at) => chart.get(at)?.views ?? 0) }\n        ]\n      },\n      lists: [\n        { title: \"Pages read most\", rows: top(lists.page) },\n        { title: \"Where visitors came from\", rows: top(lists.source, (name) => name || \"Directly (a typed address or a bookmark)\") },\n        { title: \"Devices\", rows: top(lists.device, (name) => DEVICES[name] ?? name) },\n        { title: \"Searched for on the site\", rows: top(lists.search) }\n      ]\n    };\n  }\n};\nexport {\n  actions,\n  dayIn,\n  daysOf,\n  monthsOf\n};\n"}
