{
  "name": "stats",
  "displayName": "Statistics",
  "description": "Who reads the site, counted by its own server: no cookie and no script on the pages, so visitors are asked nothing. Robots and people signed in to the admin are not counted. Keeps each day's totals for a month and each month's for good.",
  "version": "1.0.0",
  "publisher": "uhlaka",
  "uhlakaMinVersion": "0.1.0",
  "collections": [
    { "name": "days", "label": "Days", "fields": [
      { "key": "day", "label": "Day", "kind": "date" },
      { "key": "kind", "label": "What", "kind": "text" },
      { "key": "name", "label": "Name", "kind": "text" },
      { "key": "hits", "label": "Times", "kind": "number" }
    ] },
    { "name": "months", "label": "Months", "fields": [
      { "key": "month", "label": "Month", "kind": "text" },
      { "key": "kind", "label": "What", "kind": "text" },
      { "key": "name", "label": "Name", "kind": "text" },
      { "key": "hits", "label": "Times", "kind": "number" }
    ] }
  ],
  "actions": [
    { "name": "served", "label": "Count the pages seen", "writes": ["days", "months"] },
    { "name": "searched", "label": "Count the searches", "writes": ["days", "months"] },
    { "name": "forget", "label": "Forget the days older than a month", "reads": ["days"], "writes": ["days"] },
    { "name": "report", "label": "Statistics", "reads": ["days", "months"] }
  ],
  "events": [
    { "on": "page.served", "action": "served" },
    { "on": "search.made", "action": "searched" }
  ],
  "jobs": [
    { "action": "forget", "everyMinutes": 1440 }
  ],
  "views": [
    { "spec": "uhlaka.view/1", "id": "stats.report", "title": "Statistics", "type": "report", "action": "report" }
  ],
