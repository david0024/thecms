{
  "name": "accounting-ro",
  "displayName": "Romanian accounting software integration",
  "description": "Connects the shop to the owner's accounting or invoicing software in Romania, which makes the invoices: Oblio for now, SmartBill and FGO later. The software numbers each invoice with the owner's series, keeps it and sends it to e-Factura (SPV) when the account is set so; the shop keeps its PDF on the order, for the buyer. A refund makes its storno. For Oblio: the account's e-mail, its API secret, the company's CIF and the series.",
  "version": "1.0.0",
  "publisher": "uhlaka",
  "uhlakaMinVersion": "0.1.0",
  "egress": [
    "www.oblio.eu"
  ],
  "uses": [
    "orders"
  ],
