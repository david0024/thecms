          "kind": "secret",
          "required": true
        },
        {
          "key": "cif",
          "label": "The company's CIF",
          "kind": "text",
          "required": true
        },
        {
          "key": "series",
          "label": "Series of the invoices",
          "kind": "text",
          "required": true
        },
        {
          "key": "storno_series",
          "label": "Series of the storno invoices (empty for the same)",
          "kind": "text"
        },
        {
          "key": "management",
          "label": "Warehouse, when the app keeps stock (empty for none)",
          "kind": "text"
        },
        {
          "key": "collect",
          "label": "Mark a paid order's invoice as collected",
          "kind": "boolean",
