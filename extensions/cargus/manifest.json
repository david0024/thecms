{
  "name": "cargus",
  "displayName": "Cargus",
  "description": "Delivery by Cargus: its price at checkout (the owner's fixed price, or Cargus's own), Ship & Go lockers in the buyer's town, the AWB made from the order with its PDF label and cash on delivery, and the parcel followed until it is delivered, the buyer told. Needs a Cargus contract: the API key from Cargus's developer portal, and the user and password of the account.",
  "version": "1.0.0",
  "publisher": "uhlaka",
  "uhlakaMinVersion": "0.1.0",
  "egress": [
    "urgentcargus.azure-api.net"
  ],
  "uses": [
    "orders"
  ],
  "collections": [
    {
      "name": "settings",
      "label": "Settings",
      "fields": [
        {
          "key": "api_key",
          "label": "API key (subscription key)",
          "kind": "secret",
          "required": true
        },
        {
          "key": "username",
          "label": "User",
          "kind": "text",
          "required": true
        },
        {
          "key": "password",
          "label": "Password",
          "kind": "secret",
          "required": true
        },
        {
          "key": "location",
          "label": "Pick-up point id (empty for the account's first)",
          "kind": "text"
        },
        {
          "key": "pricing",
          "label": "Price of delivery",
          "kind": "choice",
          "options": [
            "fixed",
            "courier"
          ],
          "initial": "fixed"
        },
        {
          "key": "home_price",
          "label": "Fixed price to the door (lei, with VAT)",
          "kind": "number",
          "initial": 20
        },
        {
          "key": "locker_price",
          "label": "Fixed price to a Ship & Go locker (lei, with VAT)",
          "kind": "number",
          "initial": 15
        },
        {
          "key": "free_from",
          "label": "Free delivery from (lei; empty for never)",
          "kind": "number"
        },
        {
          "key": "default_weight",
          "label": "Weight of a parcel when products have none (kg)",
          "kind": "number",
          "initial": 1
        },
        {
          "key": "lockers",
          "label": "Offer Ship & Go lockers at checkout",
          "kind": "boolean",
          "initial": true
        },
        {
          "key": "auto_awb",
          "label": "Make the AWB by itself when the order is paid (or placed, when paid on delivery)",
          "kind": "boolean",
          "initial": false
        }
      ]
    },
    {
      "name": "shipments",
      "label": "Shipments",
      "fields": [
        {
          "key": "order",
          "label": "Order",
          "kind": "text",
          "unique": true
        },
        {
          "key": "number",
          "label": "Order number",
          "kind": "number"
        },
        {
          "key": "awb",
          "label": "AWB",
          "kind": "text"
        },
        {
          "key": "state",
          "label": "State",
          "kind": "choice",
          "options": [
            "making",
            "made",
            "sent",
            "delivered",
            "returned"
          ],
          "initial": "making"
        },
        {
          "key": "labelled",
          "label": "Label on the order",
          "kind": "boolean"
        },
        {
          "key": "since",
          "label": "Since",
          "kind": "text"
        }
      ]
    }
  ],
  "actions": [
    {
      "name": "quote",
      "label": "Price at checkout",
      "reads": [
        "settings"
      ]
    },
    {
      "name": "awb",
      "label": "Make the AWB",
      "on": "order",
      "reads": [
        "settings",
        "shipments"
      ],
      "writes": [
        "shipments"
      ],
      "uses": [
        "orders"
      ],
      "files": true
    },
    {
      "name": "make",
      "label": "Make the AWB later",
      "reads": [
        "settings",
        "shipments"
      ],
      "writes": [
        "shipments"
      ],
      "uses": [
        "orders"
      ],
      "files": true
    },
    {
      "name": "paid",
      "label": "Make the AWB of a paid order",
      "reads": [
        "settings"
      ],
      "uses": [
        "orders"
      ]
    },
    {
      "name": "made",
      "label": "Make the AWB of an order paid on delivery",
      "reads": [
        "settings"
      ],
      "uses": [
        "orders"
      ]
    },
    {
      "name": "follow",
      "label": "Follow the parcel",
      "reads": [
        "settings",
        "shipments"
      ],
      "writes": [
        "shipments"
      ],
      "uses": [
        "orders"
      ]
    }
  ],
  "jobs": [
    {
      "action": "make",
      "once": true
    },
    {
      "action": "follow",
      "once": true
    }
  ],
  "events": [
    {
      "on": "order.paid",
      "action": "paid"
    },
    {
      "on": "order.made",
      "action": "made"
    }
  ],
  "answers": [
    {
      "question": "checkout.delivery",
      "action": "quote"
    }
  ],
  "views": [
    {
      "spec": "uhlaka.view/1",
      "id": "cargus.settings",
      "title": "Cargus",
      "type": "list",
      "collection": "settings",
      "fields": [
        "api_key",
        "username",
        "password",
        "location",
        "pricing",
        "home_price",
        "locker_price",
        "free_from",
        "default_weight",
        "lockers",
        "auto_awb"
      ]
    },
    {
      "spec": "uhlaka.view/1",
      "id": "cargus.shipments",
      "title": "Cargus shipments",
      "type": "list",
      "collection": "shipments",
      "fields": [
        "number",
        "awb",
        {
          "field": "state",
          "display": "badge"
        },
        "labelled"
      ],
      "create": false,
      "edit": false
    }
  ],
  "messages": {
    "ro": {
