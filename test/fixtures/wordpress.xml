    <content:encoded><![CDATA[<!-- wp:heading -->
<h2 class="wp-block-heading">Welcome to the <em>workshop</em></h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>We build things. Read <a href="https://old.example/about/">about us</a>, our
<a href="http://www.old.example/2024/01/hello-world/#more">first post</a> or <a href="https://other.example/x">a friend</a>.</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":20,"sizeSlug":"medium"} -->
<figure class="wp-block-image size-medium"><a href="https://old.example/wp-content/uploads/2024/01/photo.jpg"><img src="https://old.example/wp-content/uploads/2024/01/photo-300x200.jpg" alt="The bench" class="wp-image-20"/></a><figcaption class="wp-element-caption">Our <strong>bench</strong></figcaption></figure>
<!-- /wp:image -->

<!-- wp:columns -->
<div class="wp-block-columns"><div class="wp-block-column"><p>Left</p></div><div class="wp-block-column"><ul><li>One</li><li>Two<ul><li>Two and a half</li></ul></li></ul></div></div>
<!-- /wp:columns -->

<!-- wp:table -->
<figure class="wp-block-table"><table><tbody><tr><td>Oak</td><td>120</td></tr><tr><td>Ash</td><td>90</td></tr></tbody></table></figure>
<!-- /wp:table -->

<!-- wp:embed {"url":"https://www.youtube.com/watch?v=abc"} -->
