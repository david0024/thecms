{
  "name": "shout",
  "displayName": "Shout",
  "description": "Says everything louder: a block's headings, a page's title. For the tests.",
  "version": "1.0.0",
  "publisher": "uhlaka tests",
  "uhlakaMinVersion": "0.1.0",
  "egress": ["api.shout.example", "*.cdn.example"],
  "collections": [
    { "name": "settings", "label": "Settings", "fields": [
      { "key": "name", "label": "Name", "kind": "text", "required": true },
      { "key": "key", "label": "Key", "kind": "secret" },
      { "key": "loud", "label": "Loud", "kind": "boolean", "initial": true },
      { "key": "style", "label": "Style", "kind": "choice", "options": ["caps", "stars"], "initial": "caps" }
    ] },
    { "name": "log", "label": "Log", "fields": [{ "key": "what", "label": "What", "kind": "longtext" }] }
  ],
  "actions": [
    { "name": "louder", "label": "Louder", "on": "block", "reads": ["settings"], "writes": ["log"] },
    { "name": "title", "label": "Louder title", "on": "page", "ask": [{ "key": "language", "label": "Into", "kind": "language" }], "reads": ["settings"] },
    { "name": "stamp", "label": "Stamp", "on": "page", "each": "language" },
    { "name": "ping", "label": "Ping", "reads": ["settings"] },
    { "name": "sneak", "label": "Sneak", "reads": [] },
    { "name": "slow", "label": "Slow", "timeoutSeconds": 1 },
    { "name": "crash", "label": "Crash" },
    { "name": "rotate", "label": "New key", "ask": [{ "key": "note", "label": "Why", "kind": "text" }], "reads": ["settings"], "writes": ["log"] },
    { "name": "open", "label": "Open the log" },
    { "name": "look", "label": "Look", "pictures": true }
  ],
  "views": [
    {
      "spec": "uhlaka.view/1", "id": "shout.settings", "title": "Settings", "type": "list", "collection": "settings",
      "fields": ["name", "key", { "field": "style", "display": "badge", "tones": { "stars": "warning" } }],
      "rowActions": [{ "label": "New key", "action": "rotate", "input": { "id": { "$record": "id" } }, "prompt": ["note"], "confirm": "Make a new key?", "tone": "danger", "when": [{ "field": "loud", "op": "eq", "value": true }] }],
      "actions": [{ "label": "See the log", "navigate": "shout.log" }, { "label": "Open the log", "action": "open" }]
    },
    {
      "spec": "uhlaka.view/1", "id": "shout.more", "title": "More", "type": "tabs",
      "views": [
        { "type": "list", "id": "shout.log", "title": "Log", "collection": "log", "create": false, "edit": false },
        { "type": "form", "id": "shout.ask", "title": "Ask", "action": "rotate", "submit": "Make it" }
      ]
    }
  ],
  "messages": { "ro": { "Louder": "Mai tare", "Settings": "Setări" } }
}
